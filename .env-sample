
# Path to the safecast dataset
CSV_FILE_PATH=/~path-to-your-dataset/measurements-out.csv

# Kafka Topic Name
KAFKA_TOPIC=topic_safecast

# Kafka server endpoint
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Size of the chuck that the producer needs to read each time from the csv file
CHUNK_SIZE=100

# Time gap between each meassage to be sent by the producer in seconds 
SEND_INTERVAL=1
